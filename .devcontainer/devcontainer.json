{
    "name": "fpga_lab_dev",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {},
    "customizations": {
        "vscode": {
            "extensions": [
                "VHDL-LS.rust_hdl",
                "ms-vscode.makefile-tools",
                "eamodio.gitlens",
                "ms-python.python",
                "ms-toolsai.jupyter"
            ]
        }
    },
    "forwardPorts": [8765],
    "postCreateCommand": "bash .devcontainer/scripts/setup-python.sh && ghdl --version && python3 --version && jupyter --version",
    "remoteUser": "vscode"
}
